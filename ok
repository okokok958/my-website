<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Website</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .box {
            width: 100%;
            max-width: 500px;
            background: #1e293b;
            padding: 45px 30px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        }

        h1 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        p {
            color: #cbd5e1;
            font-size: 18px;
            margin-bottom: 30px;
        }

        .pay-button {
            display: inline-block;
            background: #26a17b;
            color: white;
            text-decoration: none;
            padding: 16px 35px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            transition: 0.2s;
        }

        .pay-button:hover {
            background: #1f8a69;
        }

        .network {
            margin-top: 20px;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>

<body>

    <div class="box">

        <h1>Welcome</h1>

        <p>
            Pay securely with USDT
        </p>

        <a
            class="pay-button"
            href="https://nowpayments.io/payment/?iid=6440640335"
            target="_blank"
        >
            Pay with USDT
        </a>

        <div class="network">
            USDT • BEP20 (BNB Smart Chain)
        </div>

    </div>

</body>
</html>
